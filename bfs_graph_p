class Solution {
  public:
    vector<int> bfs(vector<vector<int>> &adj) {
        vector<int> ans;
        queue<int> q;
        vector<int> vis(adj.size(), 0);
        q.push(0);
        vis[0] = 1;
        
        while(!q.empty()){
            int front_element = q.front();
            ans.push_back(front_element);
            q.pop();
            
            for(int i=0; i<adj[front_element].size(); i++){
                if(vis[adj[front_element][i]]==0){
                    vis[adj[front_element][i]] = 1;
                    q.push(adj[front_element][i]);
                } 
                
            }
        }
        return ans;
    }
};
