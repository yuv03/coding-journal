class Solution {
private:
    bool dfs(int node,
             vector<int> adj[],
             vector<int>& vis,
             vector<int>& pathVis) {

        vis[node] = 1;
        pathVis[node] = 1;

        for (auto adjNode : adj[node]) {

            // If not visited
            if (!vis[adjNode]) {

                if (dfs(adjNode, adj, vis, pathVis)) {
                    return true;
                }
            }

            // If visited and present in current DFS path
            else if (pathVis[adjNode]) {
                return true;
            }
        }

        // Backtracking
        pathVis[node] = 0;

        return false;
    }

public:
    bool isCyclic(int V, int E, int edges[][2]) {

        // Create adjacency list
        vector<int> adj[V];

        for (int i = 0; i < E; i++) {
            int u = edges[i][0];
            int v = edges[i][1];

            adj[u].push_back(v);
        }

        vector<int> vis(V, 0);
        vector<int> pathVis(V, 0);

        // Check every component
        for (int i = 0; i < V; i++) {

            if (!vis[i]) {

                if (dfs(i, adj, vis, pathVis)) {
                    return true;
                }
            }
        }

        return false;
    }
};
