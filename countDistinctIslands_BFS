class Solution {
	public:
	
	int countDistinctIslands(vector<vector<int>> &grid) {
		
		int n = grid.size();
		int m = grid[0].size();
		
		set<vector<pair<int, int>> > st;
		
		vector<vector<int>> vis(n, vector<int>(m, 0));
		
		for (int i = 0; i < n; i++) {
			
			for (int j = 0; j < m; j++) {
				
				if (!vis[i][j] && grid[i][j] == 1) {
					
					queue<pair<int, int>> q;
					
					q.push({i, j});
					
					vis[i][j] = 1;
					
					vector<pair<int, int>> vec;
					
					int row0 = i;
					int col0 = j;
					
					while (!q.empty()) {
						
						auto [row, col] = q.front();
						q.pop();
						
						vec.push_back({row - row0, col - col0});
						
						int drow[] = {-1, 0, 1, 0};
						int dcol[] = {0, 1, 0, -1};
						
						for (int k = 0; k < 4; k++) {
							
							int nrow = row + drow[k];
							int ncol = col + dcol[k];
							
							if (nrow >= 0 && nrow < n &&
							ncol >= 0 && ncol < m &&
							!vis[nrow][ncol] &&
							grid[nrow][ncol] == 1) {
								
								q.push({nrow, ncol});
								
								vis[nrow][ncol] = 1;
							}
						}
					}
					
					st.insert(vec);
				}
			}
		}
		
		return st.size();
	}
};
