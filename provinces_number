class Solution {
private:
    void dfs(int i, vector<vector<int>> adjLs, vector<int> &vis){
        vis[i]=1;
        for(auto it: adjLs[i]){
            if(!vis[it])
            dfs(it, adjLs, vis);
        }
    }
public:
    int findCircleNum(vector<vector<int>>& isConnected) {
        int n = isConnected.size();
        vector<vector<int>> adjLs(n);
        vector<int> vis(n, 0);
        int count = 0;

        for(int i=0; i<n; i++){
            for(int j=0; j<n; j++){
                if(i!=j && isConnected[i][j]==1){
                    adjLs[i].push_back(j);
                }
            }
        }

        for(int i=0; i<n; i++){
            if(!vis[i]){
                count++;
                dfs(i, adjLs, vis);
            }
        }
        return count;

    }
};
